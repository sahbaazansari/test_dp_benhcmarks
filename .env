# ============================================================
# Input
# ============================================================

CSV_PATH=./data/nyc_dog_licenses.csv
CSV_SEP=;

# Header matching ignores spaces, punctuation and capitalisation.
BIRTH_YEAR_COLUMN=AnimalBirthYear
EXTRACT_YEAR_COLUMN=Extract Year
GENDER_COLUMN=AnimalGender


# ============================================================
# Experiment grid
# ============================================================

EPSILONS=0.1,0.25,0.5,0.75,1.0,1.25,1.5,1.75,2.0,2.25,2.5,2.75,3.0

SAMPLE_SIZES=1000,2000,3000,4000,5000,6000,7000,8000,9000,9358

REPEATS=30

# Controls selection of public sample rows, NOT DP noise.
SAMPLE_SEED=42


# ============================================================
# Public numerical bounds
# ============================================================

AGE_LOW=0
AGE_HIGH=25


# ============================================================
# Execution and outputs
# ============================================================

SPARK_MASTER=local[2]

# Use a new directory for every benchmark execution.
BENCH_OUTPUT=./results/four_queries

# Copy stdout and stderr to this file immediately; set blank to disable.
TERMINAL_LOG=./logs/benchmark.log
